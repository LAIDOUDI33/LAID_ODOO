<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- ================================================== -->
        <!-- DEMO DATA - Company Configuration                   -->
        <!-- ================================================== -->

        <!-- Configure Main Company as Algerian Company -->
        <record id="base.main_company" model="res.company">
            <field name="country_id" ref="base.dz"/>
            <field name="currency_id" ref="base.DZD"/>
            <field name="regime_imposition">reel</field>
            <field name="periodicite_tva">mensuelle</field>
            <field name="snmg_value">20000</field>
            <field name="jour_paiement">5</field>
            <field name="wilaya_id" ref="wilaya_16"/>
            <field name="centre_impots">Direction des Impôts d'Alger</field>
        </record>

        <!-- Set fiscal positions -->
        <record id="fiscal_position_local_dz" model="account.fiscal.position">
            <field name="name">Position Fiscale Locale DZ</field>
            <field name="auto_apply">True</field>
            <field name="country_id" ref="base.dz"/>
            <field name="vat_required">False</field>
        </record>

    </data>
</odoo>
