<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Record Rules for Multi-company -->
        <record id="dz_wilaya_rule" model="ir.rule">
            <field name="name">Wilaya Multi-Company</field>
            <field name="model_id" ref="model_dz_wilaya"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <record id="dz_commune_rule" model="ir.rule">
            <field name="name">Commune Multi-Company</field>
            <field name="model_id" ref="model_dz_commune"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Sequence for Payslip Number -->
        <record id="seq_hr_payslip_dz" model="ir.sequence">
            <field name="name">Bulletin de Paie DZ</field>
            <field name="code">hr.payslip.dz</field>
            <field name="prefix">BUL/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
