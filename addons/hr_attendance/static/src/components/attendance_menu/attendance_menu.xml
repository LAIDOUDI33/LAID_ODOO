<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="hr_attendance.AttendanceReviewBlock">
    <div t-if="attendanceReviewDetails" class="pt-2 w-100">
        <t t-set="isEditingAttendance"
            t-value="attendanceReviewState.editingAttendanceId === attendanceReviewDetails.id"/>
        <div class="d-flex justify-content-end text-end mb-2">
            <div>
                <strong class="fs-5 lh-1">
                    <t t-out="attendanceReviewDetails.totalDisplay"/>
                </strong>
                <div t-if="attendanceReviewDetails.showBreakSummary" class="small text-muted">
                    (<t t-out="attendanceReviewDetails.breakDisplay"/>)
                </div>
            </div>
        </div>

        <div t-if="attendanceReviewDetails.sessions and attendanceReviewDetails.sessions.length"
            class="list-group rounded-2 overflow-hidden mb-2">
            <div t-foreach="attendanceReviewDetails.sessions"
                 t-as="session"
                 t-key="session.id"
                 class="list-group-item p-0"
                 t-att-class="session.selected ? 'bg-body-tertiary' : 'list-group-item-action'">
                <div class="d-flex justify-content-between align-items-center gap-3 p-2 cursor-pointer"
                    t-on-click="() => this.selectAttendance(session.id)">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <i t-attf-class="fa fa-caret-{{ session.selected ? 'down' : 'right' }} flex-shrink-0"/>
                        <span class="text-truncate">
                            <t t-out="session.rangeLabel"/>
                        </span>
                    </div>
                    <strong class="text-nowrap">
                        <t t-out="session.durationLabel"/>
                    </strong>
                </div>
                <div t-if="session.selected" class="border-top p-2">
                    <div class="row g-2 align-items-end">
                        <div t-foreach="attendanceReviewDetails.entries"
                            t-as="entry" t-key="entry.key" class="col-6 min-w-0">
                            <label class="small fw-semibold text-muted mb-1">
                                <t t-out="entry.label"/>
                            </label>
                            <t t-if="isEditingAttendance and entry.key === 'check_in'">
                                <TimePicker
                                    cssClass="'w-100 min-w-0'"
                                    inputCssClass="'o_input border-0 border-bottom rounded-0 bg-transparent py-1 w-100'"
                                    value="this._getInlineTimeValue(attendanceReviewState.editDraft.checkIn)"
                                    onChange="(value) => this.onInlineDateTimeChange('checkIn', value)"
                                    onInvalid="() => this.updateInlineDateTimeDraft('checkIn', null)"
                                    showSeconds="false"
                                    minutesRounding="1"/>
                            </t>
                            <t t-elif="isEditingAttendance and entry.key === 'check_out'">
                                <TimePicker
                                    cssClass="'w-100 min-w-0'"
                                    inputCssClass="'o_input border-0 border-bottom rounded-0 bg-transparent py-1 w-100'"
                                    value="this._getInlineTimeValue(attendanceReviewState.editDraft.checkOut)"
                                    onChange="(value) => this.onInlineDateTimeChange('checkOut', value)"
                                    onInvalid="() => this.updateInlineDateTimeDraft('checkOut', null)"
                                    showSeconds="false"
                                    minutesRounding="1"/>
                            </t>
                            <t t-else="">
                                <div class="fw-semibold" t-att-class="entry.pending ? 'text-muted' : ''">
                                    <t t-out="entry.time"/>
                                </div>
                            </t>
                            <div class="small text-muted text-break" t-if="entry.location">
                                <t t-out="entry.location"/>
                            </div>
                        </div>
                        <div t-if="attendanceReviewDetails.showBreakSummary" class="col-12">
                            <label class="small fw-semibold text-muted mb-1">
                                Break
                            </label>
                            <div t-if="isEditingAttendance and attendanceReviewState.editDraft.checkOut"
                                class="input-group input-group-sm">
                                <input
                                    class="o_input form-control bg-transparent"
                                    type="text"
                                    t-att-value="attendanceReviewState.editDraft.breakDuration"
                                    t-on-input.stop="(ev) => this.onInlineBreakDurationInput(ev.target.value)"
                                    t-on-keydown.stop=""
                                />
                            </div>
                            <div t-else="" class="fw-semibold text-muted">
                                <t t-out="attendanceReviewDetails.selectedBreakDisplay"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</t>

<t t-name="hr_attendance.attendance_menu">
    <t t-if="this.state.isDisplayed">
        <Dropdown position="'bottom-end'"
                  beforeOpen.bind="this.beforeDropdownOpen"
                  menuClass="'p-0'"
                  state="this.dropdown">
            <button>
                <i class="oi oi-filled"
                   data-icon="circle"
                   t-attf-class="text-{{ this.state.checkedIn ? 'success' : 'danger' }}"
                   role="img"
                   aria-label="Attendance"/>
            </button>

            <t t-set-slot="content">
                <div class="att_container d-flex flex-column">
                    <div>
                        <div class="d-flex justify-content-between align-items-center gap-5 border-bottom p-2">
                            <h3 class="mb-0 ps-1">
                                <t t-if="this.state.todayAttendanceRecords.length">
                                    <small>Welcome back</small>
                                    <span class="d-block"><t t-out="this.state.employee?.name || ''"/>!</span>
                                </t>
                                <t t-else="">
                                    <small>Welcome,</small>
                                    <span class="d-block"><t t-out="this.state.employee?.name || ''"/>.</span>
                                </t>
                            </h3>
                            <b><small class="text-muted text-nowrap align-self-center"
                                t-out="this.todayDateLabel"/></b>
                        </div>
                        <div t-if="this.showVideoStream" class="d-flex justify-content-center p-3">
                            <AttendanceVideoStream
                                height="200"
                                width="240"
                                exposeCameraCapture.bind="this.setCameraCapture"
                                onStreamStateChange.bind="this.setStreamAvailable"
                            />
                        </div>
                    </div>

                    <div class="o_att_today_wrap px-2">
                        <t t-set="attendanceReviewDetails" t-value="this.attendanceDetails"/>
                        <t t-set="attendanceReviewState" t-value="this.state"/>
                        <t t-call="hr_attendance.AttendanceReviewBlock"/>
                    </div>

                    <div class="o_wrap_btn_sign_out d-flex gap-3 align-items-stretch bottom-0 p-2 z-2">
                        <button t-on-click="() => this.signInOut()"
                                t-attf-class="btn btn-{{ this.state.checkedIn ? 'warning' : 'primary' }} flex-grow-1">
                            <span t-if="!this.state.checkedIn">Check in</span>
                            <span t-else="">Check out</span>
                            <i class="oi ms-1" t-attf-data-icon="{{ this.state.checkedIn ? 'logout' : 'login' }}"/>
                        </button>
                        <button t-on-click="this.discardInlineEdit"
                                class="btn btn-secondary border">
                            Discard
                        </button>
                    </div>
                </div>
            </t>
        </Dropdown>
    </t>
</t>

</templates>
