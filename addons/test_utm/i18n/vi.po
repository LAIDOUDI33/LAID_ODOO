msgstr "Kiểm thử UTM"

#. module: test_utm
#: model:ir.module.module,summary:base.module_test_utm
msgid "UTM Tests: tests specific to the UTM module"
msgstr "Kiểm thử UTM: các kiểm thử cụ thể cho phân hệ UTM"
