        <template id="report_productlabel_zpl">
            <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                <t t-set="currency_id" t-value="pricelist.currency_id or product.currency_id"/>
                <t t-foreach="barcode_and_qty_by_product[1]" t-as="product_info">
                    <t t-set="barcode" t-value="product_info['barcode']"/>
                    <t t-set="barcode_graphic" t-value="product_info['barcode_graphic']"/>
                    <t t-set="label_packaging_uom" t-value="product_info.get('packaging') or packaging"/>
                    <t t-set="price" t-value="pricelist._get_product_price(product, 1, currency=currency_id, uom=label_packaging_uom)"/>
                    <t t-set="base_unit_price" t-value="product._get_base_unit_price(price) if show_base_unit_price and product.base_unit_count and product.base_unit_name else 0"/>
                    <t t-set="label_title" t-value="product_info['display_name_markup']"/>
                    <t t-set="label_code" t-value="product_info['default_code_markup']"/>
                    <t t-set="label_packaging" t-value="label_packaging_uom.display_name if label_packaging_uom else ''"/>
                    <t t-foreach="range(product_info['quantity'])" t-as="_">
                        <t t-translation="off">
^XA^CI28

                            <t t-if="zpl_template == 'normal' and barcode_format == 'qr'" t-call="product.normal_zpl_label_qr"/>
                            <t t-elif="zpl_template == 'normal'" t-call="product.normal_zpl_label"/>
                            <t t-elif="zpl_template == 'alternative' and barcode_format == 'qr'" t-call="product.alternative_zpl_label_qr"/>
                            <t t-elif="zpl_template == 'alternative'" t-call="product.alternative_zpl_label"/>
                            <t t-elif="zpl_template == 'small' and barcode_format == 'qr'" t-call="product.small_zpl_label_qr"/>
                            <t t-elif="zpl_template == 'small'" t-call="product.small_zpl_label"/>
                            <t t-elif="zpl_template == 'jewelry' and barcode_format == 'qr'" t-call="product.jewelry_zpl_label_qr"/>
                            <t t-elif="zpl_template == 'jewelry'" t-call="product.jewelry_zpl_label"/>
^XZ
                        </t>
                    </t>
                </t>
            </t>
