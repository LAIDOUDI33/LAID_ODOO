<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_product_service_fee" model="product.product">
        <field name="name">Service Fee</field>
        <field name="available_in_pos">True</field>
        <field name="standard_price">0.00</field>
        <field name="list_price">0.0</field>
        <field name="type">service</field>
        <field name="categ_id" eval="ref('product.product_category_services', raise_if_not_found=False)"/>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="default_code">FEE</field>
        <field name="purchase_ok">False</field>
        <field name="taxes_id" eval="[(5,)]"/>
    </record>
</odoo>
