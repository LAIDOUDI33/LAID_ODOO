<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="event_track_location_display_speaker" name="Location Display Speaker">
    <div t-if="track.image or track.partner_name" class="o_wevent_location_display_speaker d-flex align-items-center gap-3 p-2 pe-4 border rounded-3">
        <div t-if="track.image" t-field="track.image"
            t-options="{'widget': 'image', 'class': 'o_wevent_location_display_speaker_image flex-shrink-0 rounded-3 overflow-hidden', 'max_width': '256'}"/>
        <div class="lh-sm">
            <div t-if="track.partner_name" class="fw-semibold text-truncate" t-field="track.partner_name"/>
            <div class="small text-body-secondary text-truncate">
                <span t-if="track.partner_function" t-field="track.partner_function"/>
                <t t-if="track.partner_function and track.partner_company_name"> · </t>
                <span t-if="track.partner_company_name" t-field="track.partner_company_name"/>
            </div>
        </div>
    </div>
</template>

<template id="event_track_location_display_track" name="Location Display Track">
    <article t-attf-class="o_wevent_location_display_track card shadow-sm border p-3 p-md-4 #{'border-primary' if is_live else ''}">
        <div class="d-flex flex-wrap align-items-center gap-2 gap-md-3">
            <h3 class="m-0 fs-3 fw-semibold lh-sm" t-field="track.name"/>
            <div t-if="is_live and track.tag_ids" class="d-flex flex-wrap align-items-center gap-1">
                <t t-foreach="track.tag_ids" t-as="tag">
                    <span t-att-class="'badge rounded-pill o_color_%s' % (tag.color or 0)" t-out="tag.name"/>
                </t>
            </div>
            <time t-if="not is_live" class="ms-auto fw-semibold text-nowrap" t-out="format_track_time(track)"/>
        </div>
        <div t-if="is_live" class="o_wevent_location_display_live_details d-grid gap-3 gap-md-4 mt-3">
            <t t-call="website_event_track_location_display.event_track_location_display_speaker"/>
            <div t-if="track.description" class="o_wevent_location_display_description align-self-center overflow-hidden lh-base text-body-secondary">
                <t t-out="track.description"/>
            </div>
        </div>
        <div t-else="" class="mt-2">
            <t t-call="website_event_track_location_display.event_track_location_display_speaker"/>
        </div>
    </article>
</template>

<template id="event_track_location_display_empty_state" name="Location Display Empty State">
    <section class="o_wevent_location_display_empty d-flex flex-column align-items-center justify-content-center text-center">
        <h2 class="m-0 display-5 fw-semibold">That’s all folks!</h2>
        <p class="mt-2 mb-0 text-body-secondary">Thanks for joining us today.</p>
    </section>
</template>

<template id="event_track_location_display_content" name="Location Display Content">
    <main aria-live="polite" aria-atomic="true" t-attf-class="o_wevent_location_display_content #{'pt-4 pt-lg-5' if live_status in ('live', 'gap') else ''}">
        <t t-if="live_status in ('none', 'finished')">
            <t t-call="website_event_track_location_display.event_track_location_display_empty_state"/>
        </t>
        <t t-elif="live_status in ('live', 'gap')">
            <section class="o_wevent_location_display_live" aria-labelledby="o_wevent_location_display_live_title">
                <div class="o_wevent_location_display_section_heading d-flex align-items-end gap-3 gap-md-5 mb-3">
                    <h2 id="o_wevent_location_display_live_title" class="d-inline-block m-0 pb-2 pe-5 border-bottom border-3 border-primary fw-semibold">Live now</h2>
                    <time t-if="live_status == 'live'" class="ms-auto ms-md-0 pb-2 fs-4 fw-semibold text-nowrap"
                        t-out="format_track_time(live_track)"/>
                </div>
                <t t-if="live_status == 'live'">
                    <t t-set="track" t-value="live_track"/>
                    <t t-set="is_live" t-value="True"/>
                    <t t-call="website_event_track_location_display.event_track_location_display_track"/>
                </t>
                <div t-elif="live_status == 'gap'" class="o_wevent_location_display_break card shadow-sm border p-4 d-flex align-items-center justify-content-center text-center">
                    <div>
                        <p class="m-0 fs-4 fw-medium">Nothing planned right now</p>
                        <p class="mt-1 mb-0 text-body-secondary">The next session will begin shortly.</p>
                    </div>
                </div>
            </section>

            <section t-if="upcoming_tracks" class="o_wevent_location_display_upcoming mt-5" aria-labelledby="o_wevent_location_display_upcoming_title">
                <div class="o_wevent_location_display_section_heading mb-3">
                    <h2 id="o_wevent_location_display_upcoming_title"
                        class="d-inline-block m-0 pb-2 pe-5 border-bottom border-3 border-primary fw-semibold">Coming up</h2>
                </div>
                <div class="o_wevent_location_display_upcoming_list d-grid gap-3">
                    <t t-foreach="upcoming_tracks" t-as="track">
                        <t t-set="is_live" t-value="False"/>
                        <t t-call="website_event_track_location_display.event_track_location_display_track"/>
                    </t>
                </div>
            </section>
            <t t-elif="live_status == 'live'">
                <t t-call="website_event_track_location_display.event_track_location_display_empty_state"/>
            </t>
        </t>
    </main>
</template>

<template id="event_track_location_display" name="Event Location Display">
    <t t-set="no_header" t-value="True"/>
    <t t-set="no_footer" t-value="True"/>
    <t t-set="no_livechat" t-value="True"/>
    <t t-call="website.layout">
        <div id="wrap" class="o_wevent_location_display min-vh-100 p-3 p-md-4 p-xl-5 text-body"
            t-att-data-refresh-url="'/event/location-display/%s/content' % location.id">
            <header class="d-flex align-items-center justify-content-between gap-3 pb-3 pb-md-4 border-bottom">
                <span t-field="website.logo"
                    t-options="{'widget': 'image', 'max_height': '80'}"
                    class="o_wevent_location_display_logo"
                    t-att-aria-label="'Logo of %s' % website.name"
                    t-att-title="website.name"/>
                <h1 class="m-0 display-5 fw-semibold lh-1 text-end" t-field="location.name"/>
            </header>
            <t t-call="website_event_track_location_display.event_track_location_display_content"/>
        </div>
    </t>
</template>

</odoo>
