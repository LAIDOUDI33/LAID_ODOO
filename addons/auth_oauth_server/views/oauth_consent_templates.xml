<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="consent" name="OAuth Consent">
        <t t-call="web.login_layout">
            <h1 class="h4 text-center mb-4">Authorize Application</h1>
            <p>
                <strong t-out="client.client_name"/> is requesting access to your Odoo
                account for
                <strong t-out="resource.label"/>.
            </p>
            <p>
                If you allow access, you will be redirected to:
                <br/>
                <strong t-out="params['redirect_uri']"/>
            </p>
            <form method="post" action="/oauth/authorize/submit_consent" target="_top">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <t t-foreach="params.items()" t-as="param">
                    <input type="hidden" t-att-name="param[0]" t-att-value="param[1]"/>
                </t>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" name="allow" value="1" class="btn btn-primary">Allow</button>
                    <button type="submit" name="allow" value="0" class="btn btn-secondary">Deny</button>
                </div>
            </form>
        </t>
    </template>
</odoo>
