<?xml version="1.0" encoding="utf-8"?>
<!--
    Algerian Localization - Country Groups for Trade
    Module: l10n_dz (Odoo 19.4)
    
    This file defines country groups used in fiscal positions:
    - Maghreb Union (UMA) countries
    - Arab League countries
    - European Union (for import/export)
-->
<odoo>

    <!-- ============================================================
         GROUPE MAGHREB - UNION DU MAGHREB ARABE (UMA)
         Algeria, Tunisia, Morocco, Libya, Mauritania
         ============================================================ -->
    <record id="country_group_maghreb" model="res.country.group">
        <field name="name">Union du Maghreb Arabe (UMA)</field>
        <field name="note">Pays du Maghreb pour positions fiscales régionales</field>
    </record>

    <!-- Maghreb Countries -->
    <record id="country_group_line_maghreb_dz" model="res.country.group.line">
        <field name="group_id" ref="country_group_maghreb"/>
        <field name="country_id" ref="base.dz"/>
        <field name="name">Algérie</field>
    </record>

    <record id="country_group_line_maghreb_tn" model="res.country.group.line">
        <field name="group_id" ref="country_group_maghreb"/>
        <field name="country_id" ref="base.tn"/>
