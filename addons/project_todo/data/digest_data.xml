<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="digest_tip_project_todo_0" model="digest.tip">
            <field name="name">Tip: Create to-dos from anywhere</field>
            <field name="sequence">500</field>
            <field name="group_id" ref="base.group_user"/>
            <field name="tip_description" type="html">
            <div>
                <p class="tip_title">Tip: Create to-dos from anywhere</p>
                <p class="tip_content">Wherever you are, use the magic keyboard shortcut to add yourself a reminder 💡<br/>
                <ul>
                    <li><b>Alt + Shift + T</b>(Windows/Linux)</li>
                    <li><b>Ctrl + Shift + T</b>(MacOs)</li>
                </ul>
                </p>
                <img src="/project_todo/static/src/img/create_to-dos_anywhere.png" width="540" class="illustration_border"/>
            </div>
            </field>
        </record>

        <record id="digest_tip_project_todo_1" model="digest.tip">
            <field name="name">Tip: Create to-dos by Email</field>
            <field name="sequence">1000</field>
            <field name="group_id" ref="base.group_user"/>
            <field name="tip_description" type="html">
                <div>
                    <t t-set="alias_domain" t-value="object.env.company.alias_domain_id"/>
                    <p class="tip_title">Tip: Create to-dos by Email</p>
                    <t t-if="alias_domain">
                        <t t-set="alias_email" t-value="'to-do@%s' % alias_domain.name"/>
                        <p class="tip_content">Send an email to <a t-attf-href="mailto:{{alias_email}}"><t t-out="alias_email"/></a> to create a to-do for yourself.
                        Want to include others? Add their email addresses in the To field — they'll be added as assignees.</p>
                    </t>
                    <t t-else="">
                        <p class="tip_content">Send an email to your To-Do alias to create a to-do for yourself.
                        Want to include others? Add their email addresses in the To field — they'll be added as assignees.</p>
                    </t>
                    <img src="/project_todo/static/src/img/create_to_dos_email.png" width="540" class="illustration_border"/>
                </div>
            </field>
        </record>
    </data>
</odoo>
