<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_image_text_full" name="Image - Text Full Width">
    <section class="s_image_text_full pt80 pb80">
        <div class="container-fluid">
            <div class="row o_grid_mode" data-row-count="12">
                <div class="o_grid_item o_grid_item_image g-height-12 g-col-lg-6 col-lg-6" style="grid-area: 1 / 1 / 13 / 7; z-index: 0; --grid-item-padding-y: 0px; --grid-item-padding-x: 0px;">
                    <img src="/web/image/website.landscape_md_3" class="img img-fluid mx-auto" alt=""/>
                </div>
                <div class="o_grid_item g-height-4 g-col-lg-4 col-lg-4 text-center" style="grid-area: 5 / 8 / 9 / 12; z-index: 1; --grid-item-padding-x: 16px; --grid-item-padding-y: 0px;">
                    <p class="small" style="text-align: center;"><font class="text-o-color-2">WHY CHOOSE US</font></p>
                    <h2>Designed to make a difference</h2>
                    <p>Highlight what sets you apart. Focus on the value you bring and the problems you solve, and keep the message clear and concise.</p>
                    <p><a href="#" class="btn btn-primary o_translate_inline">Get started</a></p>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
