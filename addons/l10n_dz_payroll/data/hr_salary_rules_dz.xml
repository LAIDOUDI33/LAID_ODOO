    <!-- IRG_RETENU - Impôt sur Revenu Global -->
    <record id="hr_irg_retenu" model="hr.salary.rule">
        <field name="name">IRG Retenu à la Source</field>
        <field name="code">IRG_RETENU</field>
        <field name="sequence">210</field>
        <field name="category_id" ref="IRG_RETENU_CAT"/>
        <field name="parent_rule_id" ref="hr_salaire_brut"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# ============================================
# CALCUL IRG ALGÉRIE - BARÈME PROGRESSIF MENSUEL
# ============================================
# Loi de Finances 2024

# 1. Base imposable (Brut - CNAS Salarial)
base_imposable = categories.SAL_BRUT - categories.CNAS_SAL

# 2. Abattement forfaitaire 40% (max 1500 DZD/mois)
abattement_pct = 0.40
abattement_max = 1500
abattement = min(base_imposable * abattement_pct, abattement_max)

# 3. Net imposable après abattement
net_imposable = base_imposable - abattement

# 4. Parts fiscales (personnes à charge)
# 1 part = 5000 DZD d'abattement supplémentaire
parts = employee.nb_parts_fiscales or 1
abattement_parts = (parts - 1) * 5000 if parts > 1 else 0

# 5. Base finale IRG
base_irg = max(0, net_imposable - abattement_parts)

# 6. Application du barème progressif mensuel
irg = 0
tranches = [
    (22500, 0.00),      # Tranche 1: 0 - 22,500 → 0%
    (75000, 0.10),      # Tranche 2: 22,501 - 75,000 → 10%
    (120000, 0.20),     # Tranche 3: 75,001 - 120,000 → 20%
    (200000, 0.30),     # Tranche 4: 120,001 - 200,000 → 30%
    (float('inf'), 0.35) # Tranche 5: > 200,000 → 35%
]

seuil_precedent = 0
for seuil, taux in tranches:
    if base_irg > seuil_precedent:
        taxable_dans_tranche = min(base_irg, seuil) - seuil_precedent
        irg += taxable_dans_tranche * taux
    seuil_precedent = seuil

# 7. Arrondi au dinar inférieur (règle algérienne)
result = int(irg)

# Minimum de perception: 500 DZD si résultat positif
if result > 0 and result < 500:
    result = 500
        </field>
        <field name="quantity">1</field>
        <field name="register_id" ref="contribution_register_irg"/>
        <field name="appears_on_payslip">True</field>
        <field name="note">
            الضريبة على الدخل الإجمالي
            IRG - Impôt sur Revenu Global retenu à la source:
            
            Barème mensuel 2024:
            - 0 à 22,500 DZD: 0%
            - 22,501 à 75,000 DZD: 10%
            - 75,001 à 120,000 DZD: 20%
            - 120,001 à 200,000 DZD: 30%
            - Plus de 200,000 DZD: 35%
            
            Abattement: 40% du salaire imposable (max 1,500 DZD)
            Parts fiscales: 5,000 DZD/part supplémentaire
            
            Minimum de perception: 500 DZD
        </field>
    </record>

