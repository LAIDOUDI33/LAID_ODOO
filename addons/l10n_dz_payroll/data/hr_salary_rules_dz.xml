    <!-- ALLOC_FAMILIALE - Allocations Familiales -->
    <record id="hr_alloc_familiale" model="hr.salary.rule">
        <field name="name">Allocations Familiales</field>
        <field name="code">ALLOC_FAMILIALE</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="ALLOC_FAMILIALES"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Allocations familiales Algérie
# 250 DZD par enfant, maximum 3 enfants (750 DZD max)
alloc_par_enfant = 250
max_enfants = 3

# Compter les enfants à charge (optionnel depuis transfert aux caisses)
enfants = employee.children or 0
nb_enfants = min(enfants, max_enfants)

result = alloc_par_enfant * nb_enfants
        </field>
        <field name="quantity">1</field>
        <field name="note">
            المخصصات العائلية
            Allocations familiales:
            - 250 DZD par enfant à charge
            - Maximum 3 enfants (750 DZD/mois)
            Note: Transférées aux caisses sociales depuis 2021 pour nouveaux embauchés
        </field>
    </record>

    <!-- HEURES_SUP - Heures Supplémentaires -->
    <record id="hr_heures_sup" model="hr.salary.rule">
        <field name="name">Heures Supplémentaires</field>
        <field name="code">HEURES_SUP</field>
        <field name="sequence">18</field>
        <field name="category_id" ref="HEURES_SUP"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = worked_days.WORK100 and worked_days.WORK100.number_of_hours &gt; 173.33</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Heures supplémentaires selon Code du Travail algérien
# Majoration: 50% les 8 premières heures, 100% au-delà

heures_normales = 173.33  # 40h/semaine
taux_horaire = categories.SALAIRE_BASE / heures_normales

# Récupérer heures sup depuis le bulletin ou saisie manuelle
hs_payer = payslip.heures_sup or 0
hs_majorees = payslip.heures_sup_100 or 0

# Calcul avec majoration
result = (hs_payer * taux_horaire * 1.50) + (hs_majorees * taux_horaire * 2.00)
        </field>
        <field name="quantity">1</field>
        <field name="note">
            ساعات إضافية
            Heures supplémentaires majorées:
            - 8 premières HS: +50%
            - Au-delà de 8h: +100%
            Base: Article 32 de la loi 90-11
        </field>
    </record>

