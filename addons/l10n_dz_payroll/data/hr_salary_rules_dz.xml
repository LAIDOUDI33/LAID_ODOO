    <!-- SAL_BASE - Salaire de Base Mensuel -->
    <record id="hr_rule_sal_base" model="hr.salary.rule">
        <field name="name">Salaire de Base</field>
        <field name="code">SAL_BASE</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="SALAIRE_BASE"/>
        <field name="condition_select">none</field>
        <field name="amount_select">fix</field>
        <field name="amount_fix">0</field>
        <field name="quantity">1</field>
        <field name="register_id" eval="False"/>
        <field name="note">
            الراتب الأساسي
            Salaire de base mensuel selon contrat de travail.
            SMIG actuel: 20,000 DZD (configurable).
            Ce montant est défini dans le contrat de travail.
        </field>
    </record>

    <!-- PRIME_ANCIENNETE - Prime d'Ancienneté -->
    <record id="hr_rule_prime_anciennete" model="hr.salary.rule">
        <field name="name">Prime d'Ancienneté</field>
        <field name="code">PRIME_ANCIENNETE</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="PRIMES_INDEMNITES"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Calcul prime d'ancienneté selon la législation algérienne
# Barème: 1% par an après 2 ans, max 15-20% selon convention

years = 0
if employee.date_hire:
    from datetime import date
    hire_date = fields.Date.from_string(employee.date_hire)
    today = date.today()
    years = (today - hire_date).days / 365.25

rate = 0
if years >= 2:
    if years &lt;= 5:
        rate = (years - 1) * 0.01  # 1% à 4%
    elif years &lt;= 10:
        rate = 0.05 + (years - 5) * 0.01  # 5% à 9%
    elif years &lt;= 15:
        rate = 0.10 + (years - 10) * 0.01  # 10% à 14%
    elif years &lt;= 20:
        rate = 0.15 + (years - 15) * 0.01  # 15% à 19%
    else:
        rate = 0.20  # Plafond 20%

result = categories.SALAIRE_BASE * rate
        </field>
        <field name="quantity">1</field>
        <field name="note">
            مكافأة الأقدمية
            Prime d'ancienneté calculée automatiquement:
            - Après 2 ans: 1% par année supplémentaire
            - Maximum: 20% du salaire de base
            Base légale: Convention collective
        </field>
    </record>

