<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.DeleteBlockedDialog">
        <Dialog title.translate="Oops" size="'sm'">
            <p class="text-prewrap mb-0" t-out="this.props.message"/>
            <a t-if="this.props.blockedIds" href="#" class="d-block mt-2" t-on-click="this.onViewBlockedRecordsClick">View non-deletable records</a>
            <p t-if="this.props.onArchive" class="text-prewrap mb-0 mt-2" t-out="this.archiveHint"/>
            <t t-set-slot="footer">
                <t t-if="this.props.onArchive">
                    <button class="btn btn-primary" t-on-click="this.onArchiveClick">Archive</button>
                    <button class="btn btn-secondary" t-on-click="this.props.close">Discard</button>
                </t>
                <t t-else="">
                    <button class="btn btn-primary" t-on-click="this.props.close">Close</button>
                </t>
            </t>
        </Dialog>
    </t>
</templates>
