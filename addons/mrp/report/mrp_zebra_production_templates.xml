<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="finished_product_zpl_label_body">
            <t t-call="product.zpl_label_4x12">
^FO250,23^A0N,23,18^FB142,1,0,R^FD<t t-out="label_packaging"/>^FS
            </t>
        </template>

        <template id="label_production_view">
            <t t-set="uom_unit" t-value="env.ref('uom.product_uom_unit')"/>
            <t t-foreach="docs" t-as="production">
                <t t-foreach="production.move_finished_ids" t-as="move">
                    <t t-foreach="move.move_line_ids" t-as="move_line">
                        <t t-if="move_line.product_id.uom_id._has_common_reference(uom_unit)">
                            <t t-set="qty" t-value="int(move_line.quantity)"/>
                        </t>
                        <t t-else="">
                            <t t-set="qty" t-value="1"/>
                        </t>
                        <t t-set="label_quantity" t-value="1 if move_line.product_id.uom_id._has_common_reference(uom_unit) else move_line.quantity"/>
                        <t t-set="barcode" t-value="(move_line.lot_name or move_line.lot_id.name) if move_line.product_id.tracking in ['lot', 'serial'] and (move_line.lot_name or move_line.lot_id) else move_line.product_id.barcode if move_line.product_id.tracking == 'none' and move_line.product_id.barcode else ''"/>
                        <t t-set="barcode_graphic" t-value="prepare_zpl_barcode_graphic(barcode, 378, 74) if barcode else False"/>
                        <t t-set="label_title" t-value="move_line.product_id.with_context(display_default_code=False).display_name"/>
                        <t t-set="label_code" t-value="move_line.product_id.default_code or ''"/>
                        <t t-set="label_packaging" t-value="'%s %s' % (label_quantity, move_line.uom_id.display_name)"/>
                        <t t-foreach="range(qty)" t-as="item">
                            <t t-translation="off">
                                <t t-call="mrp.finished_product_zpl_label_body"/>
                            </t>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
