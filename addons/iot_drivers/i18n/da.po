#. module: iot_drivers
#: model:ir.module.module,description:base.module_iot_drivers
msgid ""
"\n"
"Hardware Poxy\n"
"=============\n"
"\n"
"This module allows you to remotely use peripherals connected to this "
"server.\n"
"\n"
"This modules only contains the enabling framework. The actual devices "
"drivers\n"
"are found in other modules that must be installed separately.\n"
"\n"
msgstr ""
"\n"
"Hardware Proxy\n"
"=============\n"
"\n"
"Dette modul gør dig istand til at forbinde til perifere enheder forbundet "
"til denne server gennem fjernadgang.\n"
"\n"
"Dette modul indeholder kun den muliggørende ramme. De faktiske "
"enhedsdrivere\n"
"findes i andre moduler, som skal installeres separat.\n"
"\n"

#. module: iot_drivers
#: model:ir.module.module,summary:base.module_iot_drivers
msgid "Connect the Web Client to Hardware Peripherals"
msgstr "Forbind web klienten til perifere hardware enheder"

#. module: iot_drivers
#: model:ir.module.module,shortdesc:base.module_iot_drivers
msgid "Hardware Proxy"
msgstr "Hardware proxy"
