<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="label_lot_template_view">
            <t t-foreach="docs" t-as="lot">
                <t t-set="barcode" t-value="lot['name']"/>
                <t t-set="barcode_graphic" t-value="lot['barcode_graphic']"/>
                <t t-set="label_title" t-value="lot['display_name_markup']"/>
                <t t-set="label_code" t-value="lot['default_code_markup']"/>
                <t t-call="product.zpl_label_4x12" t-translation="off">
                    <t name="lot_zpl_extra_info"/>
                </t>
            </t>
        </template>
        <template id="label_location_template_view">
            <t t-foreach="docs" t-as="location">
                <t t-set="barcode" t-value="location['barcode']"/>
                <t t-set="barcode_graphic" t-value="location['barcode_graphic']"/>
                <t t-set="label_title" t-value="location['label_title']"/>
                <t t-set="show_barcode_value" t-value="location['show_barcode_value']"/>
                <t t-call="stock.zpl_barcode_label_4x7"/>
            </t>
        </template>
    </data>
</odoo>
