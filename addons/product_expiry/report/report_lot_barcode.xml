<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_lot_label_expiry" inherit_id="stock.report_lot_label_meta_block">
        <xpath expr="//div[hasclass('o_label_meta_block')]" position="replace">
            <div class="o_label_meta_block">
                <div t-if="label.get('use_date')" class="o_label_meta_line">
                    B.b. <t t-out="label['use_date']" t-options='{"widget": "date"}'/>
                </div>
                <div t-if="label.get('expiration_date')" class="o_label_meta_line">
                    Exp. <t t-out="label['expiration_date']" t-options='{"widget": "date"}'/>
                </div>
            </div>
        </xpath>
    </template>

    <template id="label_lot_template_view_expiry" inherit_id="stock.label_lot_template_view">
        <xpath expr="//t[@name='lot_zpl_extra_info']" position="replace">
            <t name="lot_zpl_extra_info" t-if="lot['lot_record'].use_expiration_date and (lot['lot_record'].use_date or lot['lot_record'].expiration_date)">
                <t t-if="lot['lot_record'].use_date">
^FO222,22^A0N,21,16^FB170,1,0,R^FDB.b. <t t-out="lot['lot_record'].use_date" t-options='{"widget": "date"}'/>^FS
                </t>
                <t t-if="lot['lot_record'].expiration_date">
                    <t t-if="lot['lot_record'].use_date">
^FO222,44
                    </t>
                    <t t-else="">
^FO222,22
                    </t>
^A0N,21,16^FB170,1,0,R^FDExp. <t t-out="lot['lot_record'].expiration_date" t-options='{"widget": "date"}'/>^FS
                </t>
            </t>
        </xpath>
    </template>
</odoo>
