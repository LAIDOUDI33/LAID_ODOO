<templates xml:space="preserve">
    <t t-name="portal.identitycheck">
        <form string="Security Control">
            <h3><strong>Please enter your password to confirm you own this account</strong></h3>
            <br/>
            <div>
                <input class="form-control col-10 col-md-6" autocomplete="current-password"
                       name="password" type="password" required="required"/>
            </div>
            <a href="/web/reset_password/" class="btn btn-link" role="button">Forgot password?</a>
        </form>
    </t>
    <t t-name="portal.keydescription">
        <form string="Key Description">
            <label class="text-muted d-block mb-1">Key Name — your only way to identify that key</label>
            <h1 class="mb-3">
                <input type="text" class="form-control form-control-lg border-0" placeholder='e.g. "Odoo MCP"' name="description" required="required"/>
            </h1>

            <div class="mb-3" t-if="scope_selection and scope_selection.length > 1">
                <div class="d-flex flex-wrap gap-2">
                    <label class="text-muted d-block mb-1">Scope</label>
                    <t t-foreach="scope_selection" t-as="scope" t-key="scope[0]">
                        <input type="radio" class="btn-check" name="scope"
                            t-att-id="`scope_${scope[0]}`" t-att-value="scope[0]"
                            t-att-default-checked="scope[0] === default_scope ? '1' : undefined"/>
                        <label class="btn btn-outline-primary rounded-pill btn-sm"
                            t-attf-for="scope_#{scope[0]}" t-out="scope[1]"/>
                    </t>
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex flex-wrap gap-2">
                    <label class="text-muted d-block mb-1">Expires</label>
                    <t t-foreach="duration_selection" t-as="duration" t-key="duration[0]">
                        <input type="radio" class="btn-check" name="duration"
                            t-att-id="`duration_${duration[0]}`" t-att-value="duration[0]"
                            t-att-default-checked="duration[0] == default_duration ? '1' : undefined"/>
                        <label class="btn btn-outline-primary rounded-pill btn-sm"
                            t-attf-for="duration_#{duration[0]}" t-out="duration[1]"/>
                    </t>
                </div>
            </div>
        </form>
    </t>
    <t t-name="portal.keyshow">
        <div>
            <h3><strong>Write down your key</strong></h3>
            <p>This key won't be shown again. Please copy it and store it securely. Treat it like a password, it grants full access to your account.</p>
            <p>
                <code id="portal_api_key_value" t-out="key"/>
                <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-copy-target="#portal_api_key_value">
                    <i class="fa fa-clone"/>
                </button>
            </p>
            <div class="alert alert-info" role="alert">
                <p><strong>To login, you will need the following parameters:</strong></p>
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Python</strong>
                        <button type="button" class="btn btn-sm btn-link p-0" data-copy-target="#portal_api_key_snippet">
                            <i class="fa fa-clone"/>
                        </button>
                    </div>
                    <pre class="p-2 mb-0"><code id="portal_api_key_snippet" t-out="snippet_text"/></pre>
                </div>
            </div>
        </div>
    </t>
</templates>
