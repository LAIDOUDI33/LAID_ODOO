<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.VoicePlayer">
        <div class="o-mail-VoicePlayer d-flex align-items-center px-2 py-1 bg-200 rounded-bottom-3"
            t-att-class="{ 'o-showControls': this.voice?.showControls }">
            <div class="o-mail-VoicePlayer-wave position-absolute z-2 d-flex flex-column">
                <div class="o-mail-VoicePlayer-wrapper w-100 flex-grow-1 position-relative cursor-pointer" t-ref="this.wrapperRef">
                    <div class="o-mail-VoicePlayer-drawer position-absolute top-0 bottom-0 overflow-hidden z-1" t-ref="this.drawerRef">
                        <canvas class="position-absolute" t-ref="this.progressRef"/>
                    </div>
                    <canvas class="position-absolute" t-ref="this.waveRef"/>
                </div>
                <span class="o-mail-VoicePlayer-time align-self-end text-muted small">
                    <t t-out="this.state.currentTime"/> / <t t-out="this.state.totalTime"/>
                </span>
            </div>
            <div class="o-mail-AttachmentCard-image position-relative me-2 flex-shrink-0">
                <i class="fa fa-microphone fs-4 o-mail-VoicePlayer-mic position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-primary"/>
                <button class="o-mail-VoicePlayer-play btn p-0 border-0 shadow-none position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center fa fs-3 text-primary"
                    t-att-class="this.playIconClass" t-att-title="this.playTitle"
                    t-on-click.stop="() => this.onClickPlayPause()"/>
            </div>
            <div t-if="this.props.attachment.name" class="text-truncate align-items-center fw-bold" t-out="this.props.attachment.name"/>
            <audio t-ref="this.audioRef" class="d-none" preload="auto"/>
        </div>
    </t>

</templates>
