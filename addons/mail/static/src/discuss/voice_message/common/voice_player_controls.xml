<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.VoicePlayerControls">
        <div class="o-mail-VoicePlayer-controls position-absolute top-0 start-0 p-1 d-flex align-items-center z-3">
            <Dropdown menuClass="'d-flex flex-column py-0'" position="'top-start'">
                <button class="btn btn-sm btn-light rounded px-1 py-0" tabindex="0" role="menuitem" aria-label="Playback speed" title="Playback speed">
                    <span class="fw-semibold"><t t-out="this.playbackRate"/>x</span>
                </button>
                <t t-set-slot="content">
                    <div class="d-flex align-items-center gap-1 px-2 pt-2 pb-1 text-muted smaller">
                        <i class="oi oi-fw" data-icon="speed"/>
                        <span class="fw-bold text-uppercase">Playback speed</span>
                    </div>
                    <DropdownItem t-foreach="this.playbackRates" t-as="rate" t-key="rate"
                        class="'px-2 py-1 d-flex align-items-center rounded-0'"
                        onSelected="() => this.setPlaybackRate(rate)">
                        <i class="oi oi-fw" t-attf-data-icon="{{ this.playbackRate === rate ? 'check' : '' }}"/>
                        <span class="mx-2"><t t-out="rate"/>x</span>
                    </DropdownItem>
                </t>
            </Dropdown>
            <Dropdown menuClass="'d-flex flex-column py-0'" position="'top-start'">
                <button class="btn btn-sm btn-light rounded px-1 py-0 ms-1" tabindex="0" role="menuitem" aria-label="Volume" title="Volume">
                    <i class="oi" t-att-data-icon="this.volumeIcon"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem closingMode="'none'" class="'px-3 py-2 d-flex flex-column'">
                        <div class="d-flex align-items-center gap-1 mb-2 text-muted smaller">
                            <i class="oi oi-fw" t-att-data-icon="this.volumeIcon"/>
                            <span class="fw-bold text-uppercase">Volume</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between w-100">
                            <input type="range" class="form-range o-mail-VoicePlayer-slider m-0 me-3" min="0" max="1" step="any"
                                t-att-value="this.volume"
                                t-on-input="(ev) => this.setVolume(ev.target.value)"/>
                            <span class="small fw-semibold text-end o-mail-VoicePlayer-sliderValue"><t t-out="this.volumePercent"/>%</span>
                        </div>
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
