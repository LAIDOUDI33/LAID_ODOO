<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail.FollowerList">
        <div class="d-flex flex-column gap-1 p-2">
            <div t-if="this.otherFollowersCount > 20 || this.search.searchTerm" class="px-1 pb-1">
                <SearchInput search="this.search" placeholder.translate="Search by name or email" autofocus="true" onClear="() => this.onClearSearch()"/>
            </div>
            <div class="o-mail-FollowerList-actions d-flex align-items-center gap-1 px-2 py-1">
                <button t-if="this.props.thread.selfFollower" class="btn btn-link btn-sm text-danger d-inline-flex align-items-center gap-1 px-2" t-on-click="() => this.onClickUnfollow()" title="Unfollow">
                    <i class="fa fa-user-times" aria-hidden="true"/>
                    <span>Unfollow</span>
                </button>
                <button t-else="" class="btn btn-link btn-sm text-success d-inline-flex align-items-center gap-1 px-2" t-on-click="() => this.onClickFollow()" title="Follow">
                    <i class="fa fa-user-plus" aria-hidden="true"/>
                    <span>Follow</span>
                </button>
                <button t-if="this.props.thread.selfFollower" class="o-mail-Follower-action btn btn-link btn-sm text-muted d-inline-flex align-items-center gap-1 px-2" title="Edit Notification Preferences" t-on-click.stop="(ev) => this.onClickEdit(ev)">
                    <i class="fa fa-bell" aria-hidden="true"/>
                    <span>Notifications</span>
                </button>
                <button t-if="this.props.thread.hasWriteAccess" class="btn btn-link btn-sm text-reset d-inline-flex align-items-center gap-1 px-2 ms-auto" t-on-click="() => this.onClickAddFollowers()" title="Add Followers">
                    <i class="fa fa-plus" aria-hidden="true"/>
                    <span>Add</span>
                </button>
            </div>
            <div t-if="this.followerListView.followers.length > 0" class="o-mail-FollowerList-list d-flex flex-column gap-1 pt-1">
                <t t-foreach="this.followerListView.followers" t-as="follower" t-key="follower.id">
                    <div t-att-data-follower-id="follower.id" class="w-100">
                        <Follower follower="follower" onFollowerChanged.bind="this.onFollowerChanged" close="() => this.props.dropdown.close()"/>
                    </div>
                </t>
                <span t-if="!this.followerListView.isFullyLoaded" class="btn btn-link" t-ref="this.loadMoreRef" t-on-click="() => this.followerListView.loadFollowers({ abortSignal: this.scope.abortSignal, searchTerm: this.search.searchTerm })">Load more</span>
            </div>
            <div t-elif="this.search.searchTerm" class="dropdown-item disabled">
                No matching followers
            </div>
            <div t-elif="!this.props.thread.hasWriteAccess" class="dropdown-item disabled">
                No Followers
            </div>
        </div>
    </t>

</templates>
