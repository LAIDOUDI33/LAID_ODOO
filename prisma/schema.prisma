  timbreFiscal      Float              @default(1)  // Timbre fiscal
  amountTotal       Float              @default(0)  // Total TTC
  amountDelivered   Float              @default(0)  // Montant livré
  amountInvoiced    Float              @default(0)  // Montant facturé
  
  // Conditions
  paymentTerms      String?            // Délai paiement (jours)
  paymentMode       String?
  
  // Livraison
  shippingAddress   String?
  warehouseId       String?
  warehouse         Warehouse?         @relation("SOWarehouse", fields: [warehouseId], references: [id])
  
  // Notes
  internalNotes     String?
  customerNotes     String?
  
  // Références liées
  quotationId       String?           @unique  // Devis d'origine
  quotation         Quotation?        @relation("QuoteToOrder", fields: [quotationId], references: [id])
