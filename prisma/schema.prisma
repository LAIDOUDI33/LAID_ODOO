// ============================================================
// DOCUMENT MANAGEMENT (GESTION DOCUMENTAIRE)
// ============================================================

enum DocumentCategory {
  hr                  // RH: Contrats, CVs
  finance             // Finance: Factures, Bilans
  legal               // Juridique: Statuts, Autorisations
  administrative      // Administratif
  technical           // Technique
  commercial          // Commercial: Devis, Bons de commande
  inventory           // Inventaire
  payroll             // Paie: Bulletins
  other
}

model Document {
  id                String            @id @default(cuid())
  name              String
  description       String?
  fileName          String
  fileSize          Int               @default(0) // bytes
  mimeType          String?
  category          DocumentCategory  @default(other)
  tags              String?           // JSON array of tags
  
  // Storage
  fileUrl           String            // URL/path to stored file
  thumbnailUrl      String?
  storageProvider   String            @default("local") // local, s3, gcs
  
  // Versioning
  version           Int               @default(1)
  parentVersionId   String?
  parentVersion     Document?         @relation("DocumentVersions", fields: [parentVersionId], references: [id])
  versions          Document[]        @relation("DocumentVersions")
  
  // Access Control
  isConfidential    Boolean           @default(false)
  allowedRoles      String?           // JSON array of roles that can access
  allowedUserIds    String?           // JSON array of user IDs
  
  // Status
  status            String            @default("active") // active, archived, deleted, pending_approval
  
  // Linking
  entityType        String?          // 'employee', 'contract', 'invoice', 'po', etc.
  entityId          String?
  
  // Metadata
  uploadedById      String
  uploadedBy        User              @relation(fields: [uploadedById], references: [id])
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@map("documents")
}

// ============================================================
// PUBLIC HOLIDAYS (JOURS FÉRIERS ALGÉRIENS)
// ============================================================

enum HolidayType {
  national
  religious
  cultural
  custom
}

model PublicHoliday {
  id                String       @id @default(cuid())
  name              String
  nameAr            String?      // Nom en arabe
  date              DateTime     // For fixed annual holidays, use YYYY-MM-DD (will repeat yearly)
  type              HolidayType  @default(national)
  isRecurring       Boolean      @default(true) // True = repeats every year
  durationDays      Int          @default(1) // 1 day, or more for multi-day holidays like Aid
  
  description       String?
  isActive          Boolean      @default(true)
  
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  @@unique([companyId, date])
  @@map("public_holidays")
}

// ============================================================
// END OF SCHEMA - HASSIBA Suite ERP v2.0.0 Enterprise
// Total: 64+ Models with full Algerian ERP functionality
// Phase 1 Complete: Added Purchase Orders, Sales Orders, Quotations
