  m1Actual          Float    @default(0)
  m2Budgeted        Float    @default(0)
  m2Actual          Float    @default(0)
  m3Budgeted        Float    @default(0)
  m3Actual          Float    @default(0)
  m4Budgeted        Float    @default(0)
  m4Actual          Float    @default(0)
  m5Budgeted        Float    @default(0)
  m5Actual          Float    @default(0)
  m6Budgeted        Float    @default(0)
  m6Actual          Float    @default(0)
  m7Budgeted        Float    @default(0)
  m7Actual          Float    @default(0)
  m8Budgeted        Float    @default(0)
  m8Actual          Float    @default(0)
  m9Budgeted        Float    @default(0)
  m9Actual          Float    @default(0)
  m10Budgeted       Float    @default(0)
  m10Actual         Float    @default(0)
  m11Budgeted       Float    @default(0)
  m11Actual         Float    @default(0)
  m12Budgeted       Float    @default(0)
  m12Actual         Float    @default(0)
  
