// ============================================================
// MODULE 6: BUDGETING & TRÉSORERIE
// ============================================================

enum BudgetStatus {
  draft
  submitted
  under_review
  approved
  rejected
  active
  closed
  archived
}

enum BudgetType {
  operational        // Budget opérationnel
  investment         // Budget investissement
  revenue            // Budget revenus
  expense            // Budget dépenses
  cash_flow          // Budget trésorerie
  departmental       // Budget départemental
  project            // Budget projet
}

model Budget {
  id                String        @id @default(cuid())
  name              String
  description       String?
  code              String        @unique // BUD-YYYY-XXX
  type              BudgetType
  status            BudgetStatus  @default(draft)
  
  // Période budgétaire
  year              Int
  startMonth        Int           @default(1) // 1-12
  endMonth          Int           @default(12) // 1-12
  
  // Montants
  totalBudgeted     Float         @default(0)  // Total budgété
  totalActual       Float         @default(0)  // Total réel
  variance          Float         @default(0)  // Écart
  variancePercent   Float         @default(0)  // Écart %
  
  // Devise
  currency          String        @default("DZD")
  
  // Approbation
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  
  // Département/Responsable
  departmentId      String?
  departmentName    String?
  managerId         String?
  managerName       String?
  
  // Notes
  notes             String?
  
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  
  lines             BudgetLine[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([status])
  @@index([year])
  @@index([type])
  @@index([companyId])
  
  @@map("budgets")
}

model BudgetLine {
  id                String   @id @default(cuid())
  accountCode       String?  // Code compte SCF
  accountName       String?  // Nom du compte
  category          String?  // Catégorie (personnel, matière première, etc.)
  
  // Montants mensuels (12 colonnes)
  m1Budgeted        Float    @default(0)
  m1Actual          Float    @default(0)
  m2Budgeted        Float    @default(0)
  m2Actual          Float    @default(0)
  m3Budgeted        Float    @default(0)
  m3Actual          Float    @default(0)
  m4Budgeted        Float    @default(0)
  m4Actual          Float    @default(0)
  m5Budgeted        Float    @default(0)
  m5Actual          Float    @default(0)
  m6Budgeted        Float    @default(0)
  m6Actual          Float    @default(0)
  m7Budgeted        Float    @default(0)
  m7Actual          Float    @default(0)
  m8Budgeted        Float    @default(0)
  m8Actual          Float    @default(0)
  m9Budgeted        Float    @default(0)
  m9Actual          Float    @default(0)
  m10Budgeted       Float    @default(0)
  m10Actual         Float    @default(0)
  m11Budgeted       Float    @default(0)
  m11Actual         Float    @default(0)
  m12Budgeted       Float    @default(0)
  m12Actual         Float    @default(0)
  
  // Totaux
  totalBudgeted     Float    @default(0)
  totalActual       Float    @default(0)
  variance          Float    @default(0)
  
  budgetId          String
  budget            Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("budget_lines")
}

// ============================================================
// CASH FLOW / TRÉSORERIE
// ============================================================

enum CashFlowType {
  inflow            // Entrée (encaissement)
  outflow           // Sortie (décaissement)
}

enum CashFlowCategory {
  operating          // Exploitation
  investing          // Investissement
  financing          // Financement
}

model CashFlowEntry {
  id                String            @id @default(cuid())
  reference         String            @unique // TRS-YYYYMM-XXX
  date              DateTime
  type              CashFlowType
  category          CashFlowCategory  @default(operating)
  
  // Description
  label             String
  description       String?
  
  // Montants
  amount            Float              @default(0)
  currency          String             @default("DZD")
  
  // Comptabilité
  bankAccountId     String?
  bankAccount       BankAccount?       @relation(fields: [bankAccountId], references: [id])
  counterpartName   String?           // Nom contrepartie
  
  // Rapprochement
  reconciled        Boolean            @default(false)
  reconciledAt      DateTime?
  reconciledBy      String?
  
  // Pièce justificative
  documentRef       String?           // Référence facture, paiement...
  documentType      String?           // Type document
  
  // Prévisionnel vs Réel
  isForecast        Boolean            @default(false)
  forecastDate      DateTime?         // Date prévue si différente
  
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  @@index([date])
  @@index([type])
  @@index([category])
  @@index([companyId])
  
  @@map("cash_flow_entries")
}

// ============================================================
// MODULE 8: CRM PIPELINE VENTES AVANCÉ
// ============================================================

enum LeadStatus {
  new               // Nouveau
  contacted         // Contacté
  qualified         // Qualifié
  proposal_sent     // Proposition envoyée
  negotiation       // Négociation
  won_won           // Gagné
  lost_lost         // Perdu
}

enum LeadSource {
  website
  referral
  linkedin
  facebook
  cold_call
  exhibition
  partner
  advertising
  other
}

enum LeadRating {
  hot               // Chaud (probabilité >70%)
  warm              // Tiède (30-70%)
  cold              // Froid (<30%)
}

model Opportunity {
  id                String        @id @default(cuid())
  name              String        // Nom de l'opportunité
  reference         String        @unique // OPP-YYYY-XXX
  
  // Client potentiel ou existant
  partnerId         String?
  partner           Partner?      @relation(fields: [partnerId], references: [id])
  contactName       String?       // Nom du contact
  contactEmail      String?
  contactPhone      String?
  
  // Statut & Étape
  status            LeadStatus    @default(new)
  stage             Int           @default(1) // Étape actuelle dans le pipeline (1-5)
  
  // Source & Rating
  source            LeadSource    @default(other)
  rating            LeadRating    @default(cold)
  
  // Montants (DZD)
  expectedRevenue   Float         @default(0)  // CA espéré
  probability       Int           @default(10)  // Probabilité (%)
  weightedValue     Float         @default(0)  // Valeur pondérée = expected * proba/100
  
  // Produit/Service
  productName       String?
  productDescription String?
  quantity          Int           @default(1)
  unitPrice         Float         @default(0)
  
  // Dates importantes
  expectedCloseDate DateTime?     // Date de clôture prévue
  actualCloseDate   DateTime?
  
  // Suivi
  lastActivityAt    DateTime      @default(now())
  nextActionDate    DateTime?
  nextAction        String?       // Prochaine action
  notes             String?
  
  // Assignation
  assignedToId      String?
  assignedTo        User?         @relation("SalesAssigned", fields: [assignedToId], references: [id])
  
  // Conversion
  convertedInvoiceId String?
  lostReason        String?
  
  // Order Relations
  quotations        Quotation[]     @relation("QuotationOpportunities")
  salesOrders       SalesOrder[]    @relation("OpportunityOrders")
  
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  
  activities        Activity[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([status])
  @@index([stage])
  @@index([assignedToId])
  @@index([expectedCloseDate])
  @@index([partnerId])
  @@index([companyId])
  
  @@map("opportunities")
}

enum ActivityType {
  call
  meeting
  email
  note
  task
  demo
  proposal
  follow_up
  other
}

model Activity {
  id                String        @id @default(cuid())
  type              ActivityType
  subject           String
  description       String?
  
  // Date/Heure
  dueDate           DateTime?
  completedAt       DateTime?
  isCompleted       Boolean       @default(false)
  
  // Durée (minutes)
  durationMinutes   Int?
  
  // Participants
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  
  // Entité liée
  opportunityId     String?
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partnerId         String?
  
  // Résultat
  result            String?
  nextStep          String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
  
  @@index([userId])
  @@index([opportunityId])
  @@index([dueDate])
  @@index([type])
  
  @@map("activities")
}

// ============================================================
// MODULE 9: PURCHASE ORDERS (COMMANDES D'ACHAT)
// ============================================================

enum PurchaseOrderStatus {
  draft
  sent           // Envoyée au fournisseur
  confirmed      // Confirmée par fournisseur
  received       // Partiellement/totalement reçue
  billed         // Facturée par fournisseur
  done           // Terminée
  cancelled      // Annulée
}

model PurchaseOrder {
  id                String             @id @default(cuid())
  reference         String             @unique // ACH-YYYY-MM-XXX
  
  // Fournisseur
  partnerId         String
  partner           Partner            @relation("PurchaseOrders", fields: [partnerId], references: [id])
  
  // Société
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  
  // Dates
  date              DateTime           @default(now())
  expectedDate      DateTime?          // Date de livraison prévue
  receiptDate       DateTime?          // Date de réception effective
  
  // Statut
  status            PurchaseOrderStatus @default(draft)
  
  // Montants
  amountUntaxed     Float              @default(0)  // Total HT
  amountTax         Float              @default(0)  // Total TVA
  amountTotal       Float              @default(0)  // Total TTC
  amountReceived    Float              @default(0)  // Montant reçu/facturé
  amountBilled      Float              @default(0)  // Montant facturé
  
  // Conditions
  paymentTerms      String?            // Délai paiement (jours)
  paymentMode       String?
  incoterm          String?            // EXW, FOB, CIF, DDP...
  
  // Livraison
  shippingAddress   String?
  warehouseId       String?
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  
  // Notes
  internalNotes     String?
  supplierNotes     String?           // Notes pour le fournisseur
  
  // Références liées
  sourceType        String?           // manual, rfq, replenishment
  sourceId          String?
  
  // Workflow approbation
  workflowInstanceId String?
  
  lines             PurchaseOrderLine[]
  
  receiptItems      StockMovement[]   @relation("POReceipts")
  
  bills             Bill[]            @relation("PurchaseOrderBills")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([status])
  @@index([partnerId])
  @@index([companyId])
  @@index([date])
  
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product   @relation("POLines", fields: [productId], references: [id])
  
  description       String?
  quantity          Float    @default(1)
  unitPrice         Float    @default(0)  // Prix achat HT
  discountRate      Float    @default(0)
  tvaRate           Float    @default(19)
  
  // Montants calculés
  amountUntaxed     Float    @default(0)
  amountTax         Float    @default(0)
  amountTotal       Float    @default(0)
  
  // Réception
  quantityReceived  Float    @default(0)  // Quantité reçue
  quantityInvoiced  Float    @default(0)  // Quantité facturée
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("purchase_order_lines")
}

// ============================================================
// MODULE 10: SALES ORDERS (COMMANDES CLIENTS / BONS DE COMMANDE)
// ============================================================

enum SalesOrderStatus {
  draft
  sent            // Envoyée au client
  confirmed       // Confirmée par client
  processing      // En cours de traitement
  delivered       // Livrée partiellement/totalement
  invoiced        // Facturée
  done            // Terminée
  cancelled       // Annulée
}

model SalesOrder {
  id                String             @id @default(cuid())
  reference         String             @unique // CMD-YYYY-MM-XXX
  
  // Client
  partnerId         String
  partner           Partner            @relation("SalesOrders", fields: [partnerId], references: [id])
  
  // Société
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  
  // Dates
  date              DateTime           @default(now())
  expectedDate      DateTime?          // Date de livraison prévue
  deliveryDate      DateTime?          // Date de livraison effective
  
  // Statut
  status            SalesOrderStatus   @default(draft)
  
  // Montants
  amountUntaxed     Float              @default(0)  // Total HT
  amountTax         Float              @default(0)  // Total TVA
  timbreFiscal      Float              @default(1)  // Timbre fiscal
  amountTotal       Float              @default(0)  // Total TTC
  amountDelivered   Float              @default(0)  // Montant livré
  amountInvoiced    Float              @default(0)  // Montant facturé
  
  // Conditions
  paymentTerms      String?            // Délai paiement (jours)
  paymentMode       String?
  
  // Livraison
  shippingAddress   String?
  warehouseId       String?
  warehouse         Warehouse?         @relation("SOWarehouse", fields: [warehouseId], references: [id])
  
  // Notes
  internalNotes     String?
  customerNotes     String?
  
  // Références liées
  quotationId       String?           @unique  // Devis d'origine
  quotation         Quotation?        @relation("QuoteToOrder", fields: [quotationId], references: [id])
  opportunityId     String?
  opportunity       Opportunity?      @relation("OpportunityOrders", fields: [opportunityId], references: [id])
  
  // Utilisateur assigné
  salesPersonId     String?
  salesPerson       User?             @relation("SalesPersonOrders", fields: [salesPersonId], references: [id])
  
  lines             SalesOrderLine[]
  
  deliveryItems     StockMovement[]   @relation("SODeliveries")
  invoices          Invoice[]         @relation("SalesOrderInvoices")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([status])
  @@index([partnerId])
  @@index([companyId])
  @@index([date])
  @@index([quotationId])
  
  @@map("sales_orders")
}

model SalesOrderLine {
  id                String   @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product   @relation("SOLines", fields: [productId], references: [id])
  
  description       String?
  quantity          Float    @default(1)
  unitPrice         Float    @default(0)  // Prix vente HT
  discountRate      Float    @default(0)
  tvaRate           Float    @default(19)
  
  // Montants calculés
  amountUntaxed     Float    @default(0)
  amountTax         Float    @default(0)
  amountTotal       Float    @default(0)
  
  // Livraison/Facturation
  quantityDelivered Float    @default(0)
  quantityInvoiced Float    @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("sales_order_lines")
}

// ============================================================
// MODULE 11: QUOTATIONS/DEVIS (Offres Commerciales)
// ============================================================

enum QuotationStatus {
  draft
  sent            // Envoyé au client
  viewed          // Vu par le client
  accepted        // Accepté
  rejected        // Refusé
  expired         // Expiré
  converted       // Converti en commande
  cancelled       // Annulé
}

model Quotation {
  id                String             @id @default(cuid())
  reference         String             @unique // DEV-YYYY-MM-XXX
  
  // Client
  partnerId         String
  partner           Partner            @relation("Quotations", fields: [partnerId], references: [id])
  
  // Société
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  
  // Dates
  date              DateTime           @default(now())
  validUntil        DateTime?          // Validité du devis
  
  // Statut
  status            QuotationStatus    @default(draft)
  
  // Montants
  amountUntaxed     Float              @default(0)  // Total HT
  amountTax         Float              @default(0)  // Total TVA
  timbreFiscal      Float              @default(1)  // Timbre fiscal
  amountTotal       Float              @default(0)  // Total TTC
  
  // Conditions
  paymentTerms      String?            // Délai paiement
  paymentMode       String?
  
  // Notes
  internalNotes     String?
  customerNotes     String?
  
  // Référence opportunité
  opportunityId     String?
  opportunity       Opportunity?      @relation("QuotationOpportunities", fields: [opportunityId], references: [id])
  
  // Commercial
  salesPersonId     String?
  salesPerson       User?             @relation("QuotationSalesPersons", fields: [salesPersonId], references: [id])
  
  // Conversion
  convertedToId     String?           @unique
  convertedTo       SalesOrder?        @relation("QuoteToOrder")
  
  // PDF
  pdfUrl            String?
  
  lines             QuotationLine[]
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([status])
  @@index([partnerId])
  @@index([companyId])
  @@index([validUntil])
  @@index([opportunityId])
  
  @@map("quotations")
}

model QuotationLine {
  id                String   @id @default(cuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product   @relation("QuoteLines", fields: [productId], references: [id])
  
  description       String?
  quantity          Float    @default(1)
  unitPrice         Float    @default(0)  // Prix vente HT
  discountRate      Float    @default(0)
  tvaRate           Float    @default(19)
  
  // Montants calculés
  amountUntaxed     Float    @default(0)
  amountTax         Float    @default(0)
  amountTotal       Float    @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("quotation_lines")
}

// ============================================================
// CALENDAR & EVENTS (CALENDRIER)
// ============================================================

enum EventType {
  holiday
  meeting
  deadline
  reminder
  training
  event
  leave
}

model CalendarEvent {
  id            String     @id @default(cuid())
  title         String
  description   String?
  type          EventType  @default(event)
  startDate     DateTime
  endDate       DateTime?
  allDay        Boolean    @default(false)
  location      String?
  color         String?    // Hex color for UI
  
  // Participants
  employeeIds   String?    // JSON array of employee IDs
  isPublic      Boolean    @default(false)
  
  // Recurrence
  isRecurring   Boolean    @default(false)
  recurrenceRule String?  // RRULE format
  
  // Reminders
  reminderMinutes Int     @default(0) // minutes before event
  
  // Linking
  sourceType    String?    // 'leave', 'contract', 'meeting', etc.
  sourceId      String?
  
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  createdById   String?
  createdBy     User?      @relation(fields: [createdById], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("calendar_events")
}

// ============================================================
// CONTRACTS (CONTRATS DE TRAVAIL)
// ============================================================

enum ContractStatus {
  draft
  active
  suspended
  terminated
  expired
  renewed
}

model Contract {
  id                String          @id @default(cuid())
  reference         String          @unique // CTR-YYYY-XXX
  type              String          // cdi, cdd, internship, temporary, part_time
  status            ContractStatus  @default(draft)
  
  // Dates
  startDate         DateTime
  endDate           DateTime?
  trialEndDate     DateTime?
  terminationDate  DateTime?
  terminationReason String?
  renewalCount     Int             @default(0)
  
  // Financial
  baseSalary        Float
  currency          String          @default("DZD")
  paymentFrequency  String          @default("monthly") // weekly, biweekly, monthly
  
  // Benefits
  transportAllowance    Float    @default(0)
  housingAllowance     Float    @default(0)
  foodAllowance        Float    @default(0)
  otherBenefits        String?  // JSON object
  
  // Working conditions
  weeklyHours       Float    @default(40)
  daysLeave         Int      @default(30) // Annual leave days
  sickLeaveDays     Int      @default(15)
  location          String?
  department        String?
  jobTitle          String?
  jobGrade          String?
  
  // Legal (Algerian compliance)
  nssNumber         String?  // Numéro de Sécurité Sociale
  cnasNumber       String?
  casnosNumber     String?
  mutuelleNumber   String?
  
  // Files
  contractFileUrl   String?
  annexFilesUrls    String?  // JSON array of URLs
  
  // Notes
  internalNotes     String?
  specialClauses    String?
  
  // Relations
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  managerId         String?
  manager           Employee? @relation("ContractManager", fields: [managerId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("contracts")
}

// ============================================================
// DOCUMENT MANAGEMENT (GESTION DOCUMENTAIRE)
// ============================================================

enum DocumentCategory {
  hr                  // RH: Contrats, CVs
  finance             // Finance: Factures, Bilans
  legal               // Juridique: Statuts, Autorisations
  administrative      // Administratif
  technical           // Technique
  commercial          // Commercial: Devis, Bons de commande
  inventory           // Inventaire
  payroll             // Paie: Bulletins
  other
}

model Document {
  id                String            @id @default(cuid())
  name              String
  description       String?
  fileName          String
  fileSize          Int               @default(0) // bytes
  mimeType          String?
  category          DocumentCategory  @default(other)
  tags              String?           // JSON array of tags
  
  // Storage
  fileUrl           String            // URL/path to stored file
  thumbnailUrl      String?
  storageProvider   String            @default("local") // local, s3, gcs
  
  // Versioning
  version           Int               @default(1)
  parentVersionId   String?
  parentVersion     Document?         @relation("DocumentVersions", fields: [parentVersionId], references: [id])
  versions          Document[]        @relation("DocumentVersions")
  
  // Access Control
  isConfidential    Boolean           @default(false)
  allowedRoles      String?           // JSON array of roles that can access
  allowedUserIds    String?           // JSON array of user IDs
  
  // Status
  status            String            @default("active") // active, archived, deleted, pending_approval
  
  // Linking
  entityType        String?          // 'employee', 'contract', 'invoice', 'po', etc.
  entityId          String?
  
  // Metadata
  uploadedById      String
  uploadedBy        User              @relation(fields: [uploadedById], references: [id])
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@map("documents")
}

// ============================================================
// PUBLIC HOLIDAYS (JOURS FÉRIERS ALGÉRIENS)
// ============================================================

enum HolidayType {
  national
  religious
  cultural
  custom
}

model PublicHoliday {
  id                String       @id @default(cuid())
  name              String
  nameAr            String?      // Nom en arabe
  date              DateTime     // For fixed annual holidays, use YYYY-MM-DD (will repeat yearly)
  type              HolidayType  @default(national)
  isRecurring       Boolean      @default(true) // True = repeats every year
  durationDays      Int          @default(1) // 1 day, or more for multi-day holidays like Aid
  
  description       String?
  isActive          Boolean      @default(true)
  
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  @@unique([companyId, date])
  @@map("public_holidays")
}

