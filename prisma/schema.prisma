// ============================================================
// MODULE 2: AUDIT TRAIL (Journal des Actions - Conformité DZ)
// ============================================================

enum AuditAction {
  create
  update
  delete
  login
  logout
  view
  export
  print
  approve
  reject
  submit
  cancel
  restore
  archive
}

enum AuditModule {
  auth
  users
  company
  accounting
  invoices
  bills
  payments
  partners
  products
  inventory
  employees
  payroll
  leaves
  taxes
  reports
  settings
  system
  workflow
}

model AuditLog {
  id            String       @id @default(cuid())
  action        AuditAction
  module        AuditModule
  entityName    String?       // Nom de l'entité (ex: "Invoice", "Employee")
  entityId      String?       // ID de l'entité modifiée
  description   String?       // Description détaillée de l'action
  
  // Anciennes et nouvelles valeurs (JSON pour flexibilité)
  oldValues     String?        // JSON des anciennes valeurs
  newValues     String?        // JSON des nouvelles valeurs
  
  // Métadonnées de la requête
  ipAddress     String?       // IP de l'utilisateur
  userAgent     String?        // Navigateur/Device
  method        String?       // HTTP Method (GET, POST, PUT, DELETE)
  endpoint      String?       // API Endpoint appelé
  
  // Référence utilisateur
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  userName      String?       // Snapshot du nom (au cas où user supprimé)
  userEmail     String?       // Snapshot de l'email
  
  // Timestamps
  createdAt     DateTime     @default(now()) // Moment exact de l'action
  
  // Index pour recherche rapide
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([entityName, entityId])
  
  @@map("audit_logs")
}

// ============================================================
// MODULE 3: WORKFLOW APPROBATIONS (Circuits de Validation)
// ============================================================

enum WorkflowType {
  invoice_approval      // Approbation facture client
  bill_approval         // Approbation facture fournisseur
  leave_request         // Demande de congés
  purchase_order        // Commande d'achat
  expense_report        // Note de frais
  payroll_validation    // Validation paie
  tax_declaration       // Déclaration fiscale
  payment_approval      // Validation paiement
  document_approval     // Validation document
  custom                // Workflow personnalisé
}

enum WorkflowStatus {
  draft
  pending               // En attente
  in_progress           // En cours d'approbation
  approved              // Approuvé
  partially_approved    // Partiellement approuvé
  rejected              // Rejeté
  cancelled             // Annulé
  completed             // Terminé
}

enum StepStatus {
  pending
  approved
  rejected
  skipped
  delegated
}

enum ApprovalAction {
  submit
  approve
  reject
  request_changes
  delegate
  return_to_initiator
  cancel
}

model WorkflowDefinition {
  id                  String         @id @default(cuid())
  name                String         // Nom du workflow
  description         String?        // Description
  type                WorkflowType   // Type de workflow
  isActive            Boolean        @default(true)
  
  // Configuration
  priority            Int            @default(5) // 1-10
  maxAmount           Float?         // Montant maximum (optionnel)
  currency            String         @default("DZD")
  
  // Conditions déclenchement
  conditions          String?         // JSON conditions avancées
  
  // Notifications
  notifyCreator       Boolean        @default(true)
  notifyApprovers     Boolean        @default(true)
  notifyOnComplete    Boolean        @default(true)
  
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  
  steps               WorkflowStep[]
  instances           WorkflowInstance[]
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                  String       @id @default(cuid())
  sequenceOrder       Int          // Ordre d'exécution (1, 2, 3...)
  name                String       // Nom de l'étape
  description         String?
  
  // Type d'approbateur
  approverType        String       @default("user") // user, role, manager, department_head, specific_user
  approverRole        String?      // Rôle requis (admin, manager, accountant, hr_director...)
  approverId          String?      // Utilisateur spécifique
  department          String?      // Département concerné
  
  // Configuration étape
  isOptional          Boolean      @default(false) // Étape optionnelle
  allowDelegation     Boolean      @default(true)  // Permettre délégation
  requireComment      Boolean      @default(false) // Commentaire obligatoire
  deadlineHours       Int?         // Délai en heures (SLA)
  autoApprove         Boolean      @default(false) // Auto-approbation si conditions
  
  // Action par défaut si deadline dépassée
  onDeadlineExceeded  String       @default("escalate") // escalate, auto_approve, auto_reject
  
  definitionId        String
  definition          WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  
  approvals           WorkflowApproval[]
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  @@map("workflow_steps")
  @@unique([definitionId, sequenceOrder])
}

model WorkflowInstance {
  id                  String         @id @default(cuid())
  reference           String         @unique // REF-WF-YYYYMM-XXX
  
  // Status
  status              WorkflowStatus @default(draft)
  currentStep         Int            @default(0) // Étape actuelle
  
  // Données métier liées
  entityType          String?        // Type entité (Invoice, LeaveRequest, Bill...)
  entityId            String?        // ID de l'entité
  entityReference     String?        // Référence de l'entité (ex: FAC-2024-001)
  
  // Montant (si applicable)
  amount              Float          @default(0)
  currency            String         @default("DZD")
  
  // Description contexte
  title               String?        // Titre personnalisé de cette instance
  description         String?        // Contexte/Détails
  requestReason       String?         // Motif de la demande
  
  // Données initiales (snapshot)
  initialData         String?         // JSON snapshot au moment de la soumission
  
  // Initiator
  initiatorId         String
  initiator           User           @relation("WorkflowInitiator", fields: [initiatorId], references: [id])
  
  // Workflow définition
  definitionId        String
  definition          WorkflowDefinition @relation(fields: [definitionId], references: [id])
  
  // Approbations
  approvals           WorkflowApproval[]
  
  // Commentaires globaux
  comments            WorkflowComment[]
  
  // Dates importantes
  submittedAt         DateTime?
  completedAt         DateTime?
  lastActivityAt      DateTime       @default(now())
  
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  @@index([status])
  @@index([initiatorId])
  @@index([entityType, entityId])
  @@index([definitionId])
  
  @@map("workflow_instances")
}

model WorkflowApproval {
  id                  String       @id @default(cuid())
  stepSequence        Int          // Numéro de l'étape
  
  status              StepStatus   @default(pending)
  action              ApprovalAction?
  
  // Approbateur assigné
  approverId          String?
  approver            User?        @relation(fields: [approverId], references: [id])
  approverRole        String?      // Rôle au moment de l'assignation
  approverName        String?      // Snapshot nom
  
  // Décision
  comment             String?       // Commentaire décision
  rejectedReason      String?       // Motif rejet
  
  // Délégation
  delegatedToId       String?
  delegatedTo         User?        @relation("DelegatedApproval", fields: [delegatedToId], references: [id])
  delegationNote      String?
  
  // Timestamps
  assignedAt          DateTime?
  viewedAt            DateTime?    // Date de consultation
  actionedAt          DateTime?    // Date d'action
  deadlineAt          DateTime?    // Date limite
  
  // Instance et Step
  instanceId          String
  instance            WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId              String
  step                WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  @@index([instanceId])
  @@index([approverId])
  @@index([status])
  
  @@map("workflow_approvals")
}

model WorkflowComment {
  id                  String       @id @default(cuid())
  content             String       
  
  // Auteur
  authorId            String
  author              User         @relation(fields: [authorId], references: [id])
  
  // Pièce jointe (optionnel)
  attachmentUrl       String?
  attachmentName      String?
  
  instanceId          String
  instance            WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime     @default(now())
  
  @@map("workflow_comments")
}

// ============================================================
// MODULE 4: NOTIFICATIONS SYSTEM (Alertes In-App/Email)
// ============================================================

enum NotificationType {
  info
  success
  warning
  error
  workflow_pending      // Approbation requise
  workflow_approved     // Approuvé
  workflow_rejected     // Rejeté
  invoice_due           // Échéance facture
  payment_received      // Paiement reçu
  leave_approved // Congé approuvé
  leave_rejected // Congé rejeté
  payroll_ready // Paie disponible
  low_stock // Stock bas
  system_alert // Alerte système
}

enum NotificationChannel {
  in_app
  email
  sms
  push
  webhook
}

model Notification {
  id              String            @id @default(cuid())
  title           String
  message         String
  type            NotificationType @default(info)
  
  // Canal de notification
  channel         NotificationChannel @default(in_app)
  
  // Destinataire
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Lecture
  isRead          Boolean           @default(false)
  readAt          DateTime?
  
  // Action associée (lien vers une entité)
  actionUrl       String?           // Lien vers la page concernée
  actionLabel     String?           // Texte du bouton d'action
  entityType      String?           // Type entité liée
  entityId        String?           // ID entité liée
  
  // Données supplémentaires (JSON)
  metadata        String?           // JSON pour données custom
  
  // Email spécifique (si canal email)
  emailSent       Boolean           @default(false)
  emailSentAt     DateTime?
  
  // Priorité (1-10, 10 = urgent)
  priority        Int               @default(5)
  
  // Expiration
  expiresAt       DateTime?
  
  createdAt       DateTime          @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
  
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Préférences par type de notification
  workflowEnabled    Boolean @default(true)
  invoiceEnabled     Boolean @default(true)
  paymentEnabled     Boolean @default(true)
  leaveEnabled       Boolean @default(true)
  payrollEnabled     Boolean @default(true)
  stockEnabled       Boolean @default(true)
  systemEnabled      Boolean @default(true)
  
  // Canaux préférés
  inAppEnabled       Boolean @default(true)
  emailEnabled       Boolean @default(false)
  pushEnabled        Boolean @default(false)
  
  // Email pour notifications
  emailNotification  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([userId])
  
  @@map("notification_preferences")
}

// ============================================================
// MODULE 5: REPORTS & DOCUMENTS GENERATION
// ============================================================

enum ReportType {
  financial_statement  // États financiers
  balance_sheet        // Bilan
  income_result        // Compte résultat
  cash_flow            // Trésorerie
  invoice_report       // Rapport factures
  payroll_report       // Rapport paie
  tax_declaration     // Déclaration fiscale
  inventory_report     // Rapport stock
  sales_report         // Rapport ventes
  purchase_report      // Rapport achats
  employee_list        // Liste employés
  audit_trail          // Journal audit
  custom               // Personnalisé
}

enum ReportFormat {
  pdf
  excel
  csv
  html
  json
}

enum ReportStatus {
  generating
  completed
  failed
  scheduled
}

model Report {
  id              String          @id @default(cuid())
  name            String
  description     String?
  type            ReportType
  format          ReportFormat    @default(pdf)
  status          ReportStatus    @default(generating)
  
  // Paramètres du rapport
  parameters      String?         // JSON des filtres/paramètres
  
  // Fichier généré
  fileUrl         String?
  fileName        String?
  fileSize        Int?            // en bytes
  
  // Période couverte
  dateStart       DateTime?
  dateEnd         DateTime?
  
  // Générateur
  generatedBy     String
  generator       User            @relation(fields: [generatedBy], references: [id])
  
  // Dates
  completedAt     DateTime?
  expiresAt       DateTime?       // Expiration du fichier
  
  // Statistiques génération
  generationTimeMs Int?          // Temps de génération en ms
  recordCount     Int?            // Nombre d'enregistrements
  
  // Erreur si échec
  errorMessage    String?
  
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id])
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([type])
  @@index([status])
  @@index([generatedBy])
  @@index([companyId])
  
  @@map("reports")
}

model ReportTemplate {
  id              String          @id @default(cuid())
  name            String
  description     String?
  type            ReportType
  isDefault       Boolean         @default(false)
  
  // Template configuration
  templateConfig  String?         // JSON structure du rapport
  headerTemplate  String?         // En-tête personnalisé
  footerTemplate  String?         // Pied de page personnalisé
  logoIncluded    Boolean         @default(true)
  
  // Colonnes incluses
  columns         String?         // JSON array des colonnes
  
  // Filtres disponibles
  availableFilters String?        // JSON des filtres possibles
  
  // Tri par défaut
  defaultSort     String?         // Champ de tri default
  defaultSortOrder String?        @default("asc")
  
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id])
  
  createdBy       String?
  creator         User?           @relation(fields: [createdBy], references: [id])
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt()
  
  @@map("report_templates")
}

