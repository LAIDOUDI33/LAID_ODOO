  // Dates
  date              DateTime           @default(now())
  expectedDate      DateTime?          // Date de livraison prévue
  deliveryDate      DateTime?          // Date de livraison effective
  
  // Statut
  status            SalesOrderStatus   @default(draft)
  
  // Montants
