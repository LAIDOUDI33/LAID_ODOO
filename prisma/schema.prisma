// MODULE 9: PURCHASE ORDERS (COMMANDES D'ACHAT)
// ============================================================

enum PurchaseOrderStatus {
  draft
  sent           // Envoyée au fournisseur
  confirmed      // Confirmée par fournisseur
  partial        // Partiellement reçue (H-08 FIX: Added for partial receipts)
  received       // Totalement reçue
  billed         // Facturée par fournisseur
  done           // Terminée
  cancelled      // Annulée
}

model PurchaseOrder {
  id                String             @id @default(cuid())
  reference         String             @unique // ACH-YYYY-MM-XXX
  
  // Fournisseur
  partnerId         String
  partner           Partner            @relation("PurchaseOrders", fields: [partnerId], references: [id])
  
  // Société
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id])
  
  // Dates
  date              DateTime           @default(now())
  expectedDate      DateTime?          // Date de livraison prévue
  receiptDate       DateTime?          // Date de réception effective
  
  // Statut
  status            PurchaseOrderStatus @default(draft)
  
  // Montants
  amountUntaxed     Float              @default(0)  // Total HT
  amountTax         Float              @default(0)  // Total TVA
  amountTotal       Float              @default(0)  // Total TTC
  amountReceived    Float              @default(0)  // Montant reçu/facturé
  amountBilled      Float              @default(0)  // Montant facturé
  
  // Conditions
  paymentTerms      String?            // Délai paiement (jours)
  paymentMode       String?
  incoterm          String?            // EXW, FOB, CIF, DDP...
  
  // Livraison
  shippingAddress   String?
  warehouseId       String?
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  
  // Notes
  internalNotes     String?
  supplierNotes     String?           // Notes pour le fournisseur
  
  // Références liées
  sourceType        String?           // manual, rfq, replenishment
  sourceId          String?
  
  // Workflow approbation
  workflowInstanceId String?
  
  lines             PurchaseOrderLine[]
  
  receiptItems      StockMovement[]   @relation("POReceipts")
  
  bills             Bill[]            @relation("PurchaseOrderBills")
  
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  @@index([status])
  @@index([partnerId])
  @@index([companyId])
  @@index([date])
  
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String   @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  
  productId         String
  product           Product   @relation("POLines", fields: [productId], references: [id])
  
  description       String?
  quantity          Float    @default(1)
  unitPrice         Float    @default(0)  // Prix achat HT
  discountRate      Float    @default(0)
  tvaRate           Float    @default(19)
  
  // Montants calculés
  amountUntaxed     Float    @default(0)
  amountTax         Float    @default(0)
  amountTotal       Float    @default(0)
  
  // Réception
  quantityReceived  Float    @default(0)  // Quantité reçue
  quantityInvoiced  Float    @default(0)  // Quantité facturée
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("purchase_order_lines")
}

