// ============================================================
// MODULE 8: CRM PIPELINE VENTES AVANCÉ
// ============================================================

enum LeadStatus {
  new               // Nouveau
  contacted         // Contacté
  qualified         // Qualifié
  proposal_sent     // Proposition envoyée
  negotiation       // Négociation
  won_won           // Gagné
  lost_lost         // Perdu
}

enum LeadSource {
  website
  referral
  linkedin
  facebook
  cold_call
  exhibition
  partner
  advertising
  other
}

enum LeadRating {
  hot               // Chaud (probabilité >70%)
  warm              // Tiède (30-70%)
  cold              // Froid (<30%)
}

model Opportunity {
  id                String        @id @default(cuid())
  name              String        // Nom de l'opportunité
  reference         String        @unique // OPP-YYYY-XXX
  
  // Client potentiel ou existant
  partnerId         String?
  partner           Partner?      @relation(fields: [partnerId], references: [id])
  contactName       String?       // Nom du contact
  contactEmail      String?
  contactPhone      String?
  
  // Statut & Étape
  status            LeadStatus    @default(new)
  stage             Int           @default(1) // Étape actuelle dans le pipeline (1-5)
  
  // Source & Rating
  source            LeadSource    @default(other)
  rating            LeadRating    @default(cold)
  
  // Montants (DZD)
  expectedRevenue   Float         @default(0)  // CA espéré
  probability       Int           @default(10)  // Probabilité (%)
  weightedValue     Float         @default(0)  // Valeur pondérée = expected * proba/100
  
  // Produit/Service
  productName       String?
  productDescription String?
  quantity          Int           @default(1)
  unitPrice         Float         @default(0)
  
  // Dates importantes
  expectedCloseDate DateTime?     // Date de clôture prévue
  actualCloseDate   DateTime?
  
  // Suivi
  lastActivityAt    DateTime      @default(now())
  nextActionDate    DateTime?
  nextAction        String?       // Prochaine action
  notes             String?
  
  // Assignation
  assignedToId      String?
  assignedTo        User?         @relation("SalesAssigned", fields: [assignedToId], references: [id])
  
  // Conversion
  convertedInvoiceId String?
  lostReason        String?
  
  // Order Relations
  quotations        Quotation[]     @relation("QuotationOpportunities")
  salesOrders       SalesOrder[]    @relation("OpportunityOrders")
  
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  
  activities        Activity[]
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@index([status])
  @@index([stage])
  @@index([assignedToId])
  @@index([expectedCloseDate])
  @@index([partnerId])
  @@index([companyId])
  
  @@map("opportunities")
}

enum ActivityType {
  call
  meeting
  email
  note
  task
  demo
  proposal
  follow_up
  other
}

model Activity {
  id                String        @id @default(cuid())
  type              ActivityType
  subject           String
  description       String?
  
  // Date/Heure
  dueDate           DateTime?
  completedAt       DateTime?
  isCompleted       Boolean       @default(false)
  
  // Durée (minutes)
  durationMinutes   Int?
  
  // Participants
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  
  // Entité liée
  opportunityId     String?
  opportunity       Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partnerId         String?
  
  // Résultat
  result            String?
  nextStep          String?
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt()
  
  @@index([userId])
  @@index([opportunityId])
  @@index([dueDate])
  @@index([type])
  
  @@map("activities")
}

