enum BudgetStatus {
  draft
  submitted
  under_review
  approved
  rejected
  active
  closed
  archived
}

enum BudgetType {
  operational        // Budget opérationnel
  investment         // Budget investissement
  revenue            // Budget revenus
  expense            // Budget dépenses
  cash_flow          // Budget trésorerie
  departmental       // Budget départemental
  project            // Budget projet
}

model Budget {
  id                String        @id @default(cuid())
  name              String
  description       String?
  code              String        @unique // BUD-YYYY-XXX
  type              BudgetType
  status            BudgetStatus  @default(draft)
  
  // Période budgétaire
  year              Int
  startMonth        Int           @default(1) // 1-12
  endMonth          Int           @default(12) // 1-12
  
